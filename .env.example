# ==================================================
# Backend configuration. Copy to backend/.env
# Validated at startup by backend/src/config/env.ts (the server refuses to start on invalid values).
# ==================================================

# --- Server ---
PORT=5000
NODE_ENV=development
# Browser origins allowed by CORS and by the WebSocket handshake (comma-separated, no '*' in production)
CORS_ORIGINS=http://localhost:3000
# Set to the number of reverse proxies in front of the server so rate limiting sees real client IPs
TRUST_PROXY=0
# API docs at /api/v1/docs (default: on outside production)
# ENABLE_DOCS=true

# --- Auth (REQUIRED) ---
# Generate one: openssl rand -base64 48      (there is deliberately no default)
JWT_SECRET=
ACCESS_TOKEN_TTL=7d
STREAM_TICKET_TTL_SECONDS=60

# --- Database (Prisma + SQLite; relative to backend/prisma) ---
DATABASE_URL="file:./dev.db"

# --- Google Gemini (chat + embeddings). Without a key the server still starts, in degraded mode ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Retries for transient model errors (429/5xx) before an error is reported to the user
GEMINI_MAX_RETRIES=2
# gemini (default) | local (on-device Xenova/all-MiniLM-L6-v2, no key needed)
EMBEDDING_PROVIDER=gemini

# --- Vector store ---
# chroma (disk-backed server: `bun run chroma` or `docker compose --env-file backend/.env up chromadb`) | memory (volatile, for demos/tests)
VECTOR_STORE=chroma
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=agentic_ai_kb

# --- Tools ---
# Scopes granted to every signed-in user. Tools declare the scopes they need:
#   kb:read (knowledge_base_search)  kb:write (save_to_knowledge_base)  web (web_search, web_scrape)
#   mcp (tools from MCP servers)  -> add 'mcp' only if you trust all users with those tools
DEFAULT_USER_SCOPES=kb:read,kb:write,web
# Path to an MCP servers file (see mcp.config.example.json). Unset = no MCP tools.
# MCP_CONFIG_PATH=./mcp.config.json

# --- Limits ---
MAX_UPLOAD_MB=10
MAX_DOCS_PER_USER=200
# Uploads return 202 and are indexed in the background:
INGEST_CONCURRENCY=2          # documents indexed at once
INGEST_MAX_QUEUED=500         # waiting documents before uploads get 503 queue_full
INGEST_MAX_ATTEMPTS=3         # runs per document before an indexing failure is final
INGEST_RETRY_BASE_MS=2000     # first backoff delay between runs
EMBED_BATCH_SIZE=32           # chunks per embedding request
EMBED_BATCH_INTERVAL_MS=0     # minimum gap between embedding requests (raise on tight quotas)
MAX_MESSAGE_CHARS=4000
MAX_TOOL_CALLS_PER_TURN=6
MAX_MODEL_CALLS_PER_TURN=8
RATE_LIMIT_AUTH_PER_MIN=20
RATE_LIMIT_CHAT_PER_MIN=30
RATE_LIMIT_DOCS_PER_MIN=30
SSE_HEARTBEAT_MS=10000

# --- Logging / tracing ---
LOG_LEVEL=info
# LangSmith tracing (optional)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
